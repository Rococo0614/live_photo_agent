# Local planner (Qwen text model)
LPA_LOCAL_MODEL_DIR=/path/to/Qwen2.5-7B-Instruct
LPA_LOCAL_DEVICE=cuda
LPA_LOCAL_DTYPE=float16
LPA_LOCAL_QUANTIZATION=nf4
LPA_LOCAL_MAX_NEW_TOKENS=768

# Local VLM for content summaries and template parsing
LPA_VLM_MODEL_DIR=/path/to/Qwen2.5-VL-7B-Instruct
LPA_VLM_DEVICE=cuda
LPA_VLM_DTYPE=float16
LPA_VLM_QUANTIZATION=nf4
LPA_VLM_MAX_NEW_TOKENS=256
LPA_VLM_TEMPLATE_SCORE_CANDIDATE_LIMIT=3
